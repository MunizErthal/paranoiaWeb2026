rules_version = '2';

// Regras de segurança do Firestore para o projeto paranoiajogos.
//
// Aplicar manualmente no console do Firebase (Firestore Database > Regras)
// até o firebase-tools/CI estar configurado neste ambiente. Este arquivo é
// mantido em sincronia manual com o que está de fato publicado no console —
// depois de aplicar uma mudança lá, replique aqui também.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return 'admin' in get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('permissoes', []);
    }

    function usuarioAtivo() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.ativo == true;
    }

    // Usuários - proteção total
    match /usuarios/{uid} {
      allow read: if (request.auth.uid == uid || isAdmin()) && usuarioAtivo();
      allow create: if request.auth.uid == uid
        && request.resource.data.id == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.ativo == true;
      allow update: if request.auth.uid == uid
        && usuarioAtivo()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['id', 'email', 'permissoes', 'criadoEm']);
      allow delete: if false;
    }

    // TopSecrets - apenas usuários ativos e autenticados
    match /topsecrets/{document=**} {
      allow read, write: if request.auth != null && usuarioAtivo();
    }

    // PRODUTOS
    match /produtos/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && usuarioAtivo();
    }

    // CUPONS — leitura pública (preview/validação no carrinho), escrita só
    // por Cloud Function (Admin SDK). processarPagamento é quem revalida o
    // desconto e incrementa usosTotais — nunca o client.
    match /cupons/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // Tudo mais - bem permissivo
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
